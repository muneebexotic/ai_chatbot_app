{
  "@@locale": "en",

  "appName": "SpeakWise",
  "@appName": {
    "description": "The product name. A coined compound, not a dictionary word: do not translate it, and keep the internal capital. Settled by the owner on 2026-07-28 (PRD §17.1, DECISIONS D9); the working name was Kalaam."
  },

  "splashTagline": "Speak. Hear how you sounded.",
  "@splashTagline": {
    "description": "Subtitle under the product name on the splash screen. Replaced 'AI-Powered Conversations', which §7.6 bans by name. States what the product does, not what it is built from."
  },

  "welcomeTitle": "Welcome to SpeakWise",
  "@welcomeTitle": {
    "description": "Heading on the first screen a signed-out user sees. Read 'Welcome to ChadGPT' until Milestone 3 — a product name nothing else in the app used any more, found on a device screenshot rather than by a test. Keep it in step with appName."
  },

  "welcomeSubtitle": "Practise speaking out loud, and find out how you sounded.",
  "@welcomeSubtitle": {
    "description": "Sub-heading under welcomeTitle. Replaced 'Your AI companion for intelligent conversations', which described a chat wrapper rather than this product — §3 is explicit that competing as a general chatbot is the losing position."
  },

  "authLogin": "Login",
  "@authLogin": {
    "description": "Primary action on the welcome screen and the label on the login form's submit button."
  },

  "authSignUp": "Sign Up",
  "@authSignUp": {
    "description": "Secondary action on the welcome screen; creates an account."
  },

  "authContinueWith": "or continue with",
  "@authContinueWith": {
    "description": "Divider above the third-party sign-in buttons."
  },

  "authInvalidCredentials": "That email and password do not match. Check both, or reset your password.",
  "@authInvalidCredentials": {
    "description": "Sign-in refused. Deliberately covers both a wrong password and an unknown email: distinguishing them would tell an anonymous caller which addresses have accounts."
  },

  "authEmailAlreadyRegistered": "That email already has an account. Sign in instead, or reset the password.",
  "@authEmailAlreadyRegistered": {
    "description": "Sign-up refused because the address is in use."
  },

  "authWeakPassword": "That password is too short. Use at least eight characters.",
  "@authWeakPassword": {
    "description": "Sign-up refused for password length. States the actual minimum, because an error has to state its fix (§7.6)."
  },

  "authEmailNotConfirmed": "Check your email and open the confirmation link, then sign in.",
  "@authEmailNotConfirmed": {
    "description": "Credentials were correct but the address is unconfirmed."
  },

  "authInvalidEmail": "That does not look like an email address.",
  "@authInvalidEmail": {
    "description": "The address failed format validation."
  },

  "authGoogleUnavailable": "Google sign-in is not available yet. Use an email address and password.",
  "@authGoogleUnavailable": {
    "description": "Shown when the project has sign-ups disabled, reused for Google sign-in being unavailable. Honest about the state of the world rather than letting the tap appear to do nothing."
  },

  "failureOffline": "No internet connection. Your details are not sent until you reconnect.",
  "@failureOffline": {
    "description": "No usable network. Must never read as though the user lost work (R11.5)."
  },

  "failureRateLimited": "Too many attempts. Wait a minute and try again.",
  "@failureRateLimited": {
    "description": "Going too fast, and the server did not say for how long."
  },

  "failureRateLimitedFor": "Too many attempts. Try again in {seconds} seconds.",
  "@failureRateLimitedFor": {
    "description": "Going too fast, and the server said how long to wait.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "30"
      }
    }
  },

  "failureUnauthorized": "Your session ended. Sign in again.",
  "@failureUnauthorized": {
    "description": "The caller is not authenticated, or the token expired."
  },

  "failureInvalidRequest": "That did not go through. Check the details and try again.",
  "@failureInvalidRequest": {
    "description": "The server rejected the request shape. Usually a bug in this client, so it stays generic to the user and loud in the log."
  },

  "failureStorage": "Could not save to this device. Check your available storage.",
  "@failureStorage": {
    "description": "Local persistence failed."
  },

  "failureDevice": "This device would not allow {capability}.",
  "@failureDevice": {
    "description": "A device capability was refused or is missing: microphone permission, a speech recogniser, a text-to-speech voice.",
    "placeholders": {
      "capability": {
        "type": "String",
        "example": "the microphone"
      }
    }
  },

  "failureQuotaExceeded": "You have used your allowance for today.",
  "@failureQuotaExceeded": {
    "description": "The daily cap is reached. Never a dead end — free users still have unlimited Drill Mode (§8, DECISIONS D2)."
  },

  "failureSafetyBlocked": "That request was refused.",
  "@failureSafetyBlocked": {
    "description": "The provider's safety system refused the request or response. Plain and non-judgemental by requirement (R10.5)."
  },

  "failureAtCapacity": "The service is at capacity right now. Try again shortly.",
  "@failureAtCapacity": {
    "description": "The global circuit breaker tripped (R10.4). Not the user's fault and not fixed by upgrading."
  },

  "failureUnknown": "Something failed and we do not yet know what. Try again; if it keeps happening, it is a bug worth reporting.",
  "@failureUnknown": {
    "description": "Unclassified failure. Every occurrence is a gap in the AppFailure taxonomy."
  },

  "actionKeep": "Keep",
  "@actionKeep": {
    "description": "Declines a destructive action in a confirmation dialog. The safe choice is named for what it does, not 'Cancel' — 'Cancel' is ambiguous when the thing being confirmed is itself a cancellation."
  },

  "chatComposerHint": "Type a message",
  "@chatComposerHint": {
    "description": "Placeholder in the chat input field."
  },

  "chatSend": "Send",
  "@chatSend": {
    "description": "Accessibility label for the send button, which is an arrow icon with no visible text."
  },

  "chatNewConversation": "New conversation",
  "@chatNewConversation": {
    "description": "Tooltip on the action that abandons the current thread and starts a fresh one."
  },

  "chatThinking": "Thinking",
  "@chatThinking": {
    "description": "Screen-reader label for the waveform shown while waiting for the first word of a reply. Sighted users see the waveform idle; this is the only channel a screen reader has."
  },

  "chatCopy": "Copy",
  "@chatCopy": {
    "description": "Copies a code block to the clipboard."
  },

  "chatCopied": "Copied",
  "@chatCopied": {
    "description": "Replaces the copy label for two seconds after a successful copy. Confirmation in place, not a snackbar over the conversation."
  },

  "chatCodeBlock": "code",
  "@chatCodeBlock": {
    "description": "Header on a fenced code block whose language the model did not state."
  },

  "chatReplyTruncated": "The reply stopped at its length limit.",
  "@chatReplyTruncated": {
    "description": "Shown under a reply that hit the token ceiling rather than finishing. Said plainly because a paragraph ending mid-thought otherwise reads as a bug."
  },

  "chatRetry": "Try again",
  "@chatRetry": {
    "description": "Resends the last message after a recoverable failure."
  },

  "chatSeePro": "See Pro",
  "@chatSeePro": {
    "description": "Opens the subscription screen from the quota message. Shown ONLY when upgrading would actually lift the limit — never for the fair-use ceiling, where it would be selling something that changes nothing (§16)."
  },

  "chatDismiss": "Dismiss",
  "@chatDismiss": {
    "description": "Closes the error bar."
  },

  "chatErrorOffline": "No internet. Your message is not sent yet, and nothing is lost.",
  "@chatErrorOffline": {
    "description": "The request never reached the server. R11.5: must never read as though the user lost their words."
  },

  "chatErrorAtCapacity": "At capacity right now. Your conversation is saved. Try again in a few minutes.",
  "@chatErrorAtCapacity": {
    "description": "The global circuit breaker tripped, or the provider refused (R10.4). Not the user's fault and not fixed by upgrading, so it says neither."
  },

  "chatErrorSafetyBlocked": "That one was refused. Try asking it a different way.",
  "@chatErrorSafetyBlocked": {
    "description": "The provider's safety system refused. R10.5 requires plain and non-judgemental, with no automatic retry."
  },

  "chatErrorSignedOut": "Your session ended. Sign in again to keep going.",
  "@chatErrorSignedOut": {
    "description": "The token expired or was revoked mid-conversation."
  },

  "chatErrorEmailNotConfirmed": "Confirm your email address first. Check your inbox for the link.",
  "@chatErrorEmailNotConfirmed": {
    "description": "R10.2 requires a verified address before any model call."
  },

  "chatErrorRateLimited": "Too many messages too quickly. Wait a minute and carry on.",
  "@chatErrorRateLimited": {
    "description": "R10.1 hourly fair use, with no wait time from the server."
  },

  "chatErrorRateLimitedFor": "Too many messages too quickly. Carry on in about {minutes} minutes.",
  "@chatErrorRateLimitedFor": {
    "description": "R10.1 hourly fair use, with a server-supplied wait.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "12"
      }
    }
  },

  "chatErrorQuotaFree": "That is your last message for today. It resets at midnight.",
  "@chatErrorQuotaFree": {
    "description": "The free daily allowance is spent (§8). Paired with the only See Pro button in the chat surface — R8.3 permits the paywall at exactly two moments and this is one of them."
  },

  "chatErrorQuotaFairUse": "You have hit the daily fair-use ceiling. It resets at midnight.",
  "@chatErrorQuotaFairUse": {
    "description": "A Pro user at the R10.1 ceiling. Deliberately offers no upgrade: there is nothing above this tier, and offering one anyway would be a dark pattern."
  },

  "chatErrorInvalid": "That did not go through. Try sending it again.",
  "@chatErrorInvalid": {
    "description": "The server rejected the request shape — a bug in this client, so it stays generic to the user and loud in the log."
  },

  "chatErrorUnknown": "That did not work, and we do not yet know why.",
  "@chatErrorUnknown": {
    "description": "Unclassified gateway failure."
  },

  "chatEmptyTitle": "Say something.",
  "@chatEmptyTitle": {
    "description": "Empty chat, before partners have loaded. Replaced a row of image-generation suggestion chips (§16)."
  },

  "chatEmptyTitleWithPartner": "{partner} is listening.",
  "@chatEmptyTitleWithPartner": {
    "description": "Empty chat, naming the selected partner. §7.6: an empty state invites an action.",
    "placeholders": {
      "partner": {
        "type": "String",
        "example": "Interviewer"
      }
    }
  },

  "chatEmptyBody": "Type below, or tap the name above to talk to someone else.",
  "@chatEmptyBody": {
    "description": "Empty chat, second line. Points at the two things this screen can do."
  },

  "chatMessagesRemaining": "{count, plural, =1{1 message left today} other{{count} messages left today}}",
  "@chatMessagesRemaining": {
    "description": "Shown only in the last five messages of the daily allowance. A counter visible from the first message would be manufactured scarcity (§16).",
    "placeholders": {
      "count": {
        "type": "num",
        "format": "compact"
      }
    }
  },

  "partnersTitle": "Who are you talking to",
  "@partnersTitle": {
    "description": "Header of the partner picker sheet. A question without a question mark — §7.6 is plain and a little dry."
  },

  "partnersUnavailable": "Could not load partners. Check your connection.",
  "@partnersUnavailable": {
    "description": "The partner list failed to load."
  },

  "threadsTitle": "Conversations",
  "@threadsTitle": {
    "description": "Header of the history drawer."
  },

  "threadsEmpty": "No conversations yet. The first one starts when you send a message.",
  "@threadsEmpty": {
    "description": "Empty history. §7.6's model for an empty state is 'No sessions yet. The first one takes 60 seconds.'"
  },

  "threadsUnavailable": "Could not load your conversations. Check your connection.",
  "@threadsUnavailable": {
    "description": "The thread list failed to load."
  },

  "threadUntitled": "Untitled",
  "@threadUntitled": {
    "description": "A thread whose title is empty, which should not happen — the server derives one from the first message."
  },

  "threadDelete": "Delete",
  "@threadDelete": {
    "description": "Deletes a conversation and its messages."
  },

  "threadDeleteTitle": "Delete this conversation",
  "@threadDeleteTitle": {
    "description": "Confirmation dialog title."
  },

  "threadDeleteBody": "The messages go with it. This cannot be undone.",
  "@threadDeleteBody": {
    "description": "Confirmation dialog body. States the consequence rather than asking 'Are you sure?', which conveys nothing."
  },

  "dateToday": "Today",
  "@dateToday": {
    "description": "Relative date on a conversation row."
  },

  "dateYesterday": "Yesterday",
  "@dateYesterday": {
    "description": "Relative date on a conversation row."
  },

  "dateDaysAgo": "{days} days ago",
  "@dateDaysAgo": {
    "description": "Relative date on a conversation row, for the last week.",
    "placeholders": {
      "days": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "settingsTitle": "Settings",
  "@settingsTitle": {
    "description": "Settings entry in the drawer."
  },

  "memoryTitle": "Memory",
  "@memoryTitle": {
    "description": "The screen listing what the app has stored about the user."
  },

  "memoryExplainer": "Your partner remembers these between conversations, so you do not have to repeat yourself. Remove anything you would rather it forgot.",
  "@memoryExplainer": {
    "description": "Opening line of the Memory screen. Answers 'why does it know this' before listing anything."
  },

  "memoryNeverStored": "Never stored, whatever you say: health, religion, politics, sexual orientation, money, ID numbers, your address, or anything about other people.",
  "@memoryNeverStored": {
    "description": "R5.2.4's eight forbidden categories in plain words. A promise the implementation keeps with a deny-instruction in the extraction prompt and a keyword filter over every candidate — not boilerplate."
  },

  "memoryEmpty": "Nothing stored yet. Facts appear here after a few exchanges.",
  "@memoryEmpty": {
    "description": "Empty Memory screen."
  },

  "memoryUnavailable": "Could not load your memory. Check your connection.",
  "@memoryUnavailable": {
    "description": "The memory list failed to load."
  },

  "memoryForgetOne": "Forget this",
  "@memoryForgetOne": {
    "description": "Tooltip on the delete button for a single stored fact."
  },

  "memoryForgetAll": "Forget everything",
  "@memoryForgetAll": {
    "description": "R5.2.2 names this action explicitly."
  },

  "memoryForgetAllTitle": "Forget everything",
  "@memoryForgetAllTitle": {
    "description": "Confirmation dialog title for clearing all memory."
  },

  "memoryForgetAllBody": "Your partner starts from nothing next time. Your conversations stay.",
  "@memoryForgetAllBody": {
    "description": "Confirmation dialog body. The second sentence matters: people expect 'forget everything' to delete their transcripts too, and it does not."
  },

  "waveformLive": "LIVE",
  "@waveformLive": {
    "description": "Drawn beside the waveform while the microphone is capturing. The TEXT channel of the live indicator — with it, mic state is legible without perceiving colour at all (WCAG 1.4.1). Keep it short and uppercase; it is read at a glance from across a room."
  },

  "waveformLiveSemantics": "Microphone live, recording. {context}",
  "@waveformLiveSemantics": {
    "description": "Screen-reader announcement while the microphone is capturing. The mic being hot is the one state a non-sighted user cannot infer any other way (§11.6), so it comes first and the caller's own label follows. {context} is often empty.",
    "placeholders": {
      "context": {
        "type": "String",
        "example": "Session with Interviewer"
      }
    }
  },

  "sessionStartSpeaking": "Start speaking",
  "@sessionStartSpeaking": {
    "description": "R4.1.1's single primary action on the session home. §7.6 requires a button to say what happens, so it is a verb phrase rather than 'Begin' or 'Go'."
  },

  "sessionHomeTitle": "Who are you talking to?",
  "@sessionHomeTitle": {
    "description": "Heading above the partner rail on the session home (R4.1.1)."
  },

  "sessionHomeEmptyHistory": "No sessions yet. The first one takes 60 seconds.",
  "@sessionHomeEmptyHistory": {
    "description": "Empty state for session history. §7.6 gives this exact sentence as its worked example of an empty state that invites an action rather than describing a void."
  },

  "sessionHistoryTitle": "Recent sessions",
  "@sessionHistoryTitle": {
    "description": "Heading above the list of past sessions on the session home."
  },

  "sessionRecoveredTitle": "A session ended unexpectedly",
  "@sessionRecoveredTitle": {
    "description": "Shown when a session was force-killed and its transcript survived (R4.2.6). Deliberately not an apology and not an error: the user's work is intact, and this is the offer to see it."
  },

  "sessionRecoveredBody": "{minutes} minutes were saved. You can still see the transcript.",
  "@sessionRecoveredBody": {
    "description": "Body of the recovered-session notice. States what survived, in the user's terms.",
    "placeholders": { "minutes": { "type": "int", "example": "4" } }
  },

  "sessionBriefExample": "How it opens",
  "@sessionBriefExample": {
    "description": "Label above the partner's example opening line on the brief screen (R4.1.3)."
  },

  "sessionBriefGoalLabel": "What do you want to practise?",
  "@sessionBriefGoalLabel": {
    "description": "Label for R4.1.3's optional one-line goal, which is passed into the session prompt and stored on the session record."
  },

  "sessionBriefGoalHint": "I have a frontend interview on Tuesday",
  "@sessionBriefGoalHint": {
    "description": "Placeholder for the goal field. The PRD's own example in R4.1.3. Concrete on purpose: an abstract hint produces abstract goals."
  },

  "sessionBriefGoalOptional": "Optional. The partner will work to it.",
  "@sessionBriefGoalOptional": {
    "description": "Helper text under the goal field, saying plainly that it can be skipped and what it does if it is not."
  },

  "sessionPermissionTitle": "SpeakWise needs the microphone",
  "@sessionPermissionTitle": {
    "description": "Step 1 of R4.1.2's first-run flow. Names the app rather than saying 'we', so it reads the same as the system dialog that follows it."
  },

  "sessionPermissionBody": "It listens while you speak, so it can show your words and measure how you sounded.",
  "@sessionPermissionBody": {
    "description": "R4.1.2 requires 'a plain explanation of why'. States the benefit rather than the mechanism."
  },

  "sessionPrivacyTitle": "Your voice stays on this phone",
  "@sessionPrivacyTitle": {
    "description": "R4.2.7 requires this to be stated plainly in the UI on first run, 'because it is both true and a genuine selling point'."
  },

  "sessionPrivacyBody": "Speech is recognised on the device. No audio is recorded, uploaded, or stored. Only the text of what you said is sent, so the partner can reply.",
  "@sessionPrivacyBody": {
    "description": "R4.2.7 in full. The last clause is load-bearing: claiming nothing leaves the device would be false, and a privacy claim with an unstated exception is worse than no claim."
  },

  "sessionPermissionGrant": "Allow the microphone",
  "@sessionPermissionGrant": {
    "description": "Button that triggers the system permission dialog."
  },

  "sessionPermissionDeniedTitle": "The microphone is blocked",
  "@sessionPermissionDeniedTitle": {
    "description": "Shown when the permission was permanently denied, which no in-app prompt can undo."
  },

  "sessionPermissionDeniedBody": "Turn it on in Settings to speak. You can still practise by typing.",
  "@sessionPermissionDeniedBody": {
    "description": "§7.6 requires an error to state its cause and its fix. Names the real fix and the real alternative, rather than offering a retry that cannot work."
  },

  "sessionOpenSettings": "Open Settings",
  "@sessionOpenSettings": {
    "description": "Sends the user to the system app-settings page to grant a permanently denied permission."
  },

  "sessionCalibrateTitle": "Say something",
  "@sessionCalibrateTitle": {
    "description": "Step 2 of R4.1.2: a five-second microphone level check with a live waveform."
  },

  "sessionCalibrateBody": "Anything at all, in your normal voice. This checks the microphone is picking you up.",
  "@sessionCalibrateBody": {
    "description": "Instruction for the level check. 'Normal voice' is load-bearing: a user who projects for the test will be under-detected in the session itself."
  },

  "sessionCalibrateGood": "That came through clearly.",
  "@sessionCalibrateGood": {
    "description": "Result of a successful microphone level check."
  },

  "sessionCalibrateQuiet": "That was very quiet. Move somewhere calmer, or hold the phone closer.",
  "@sessionCalibrateQuiet": {
    "description": "Result of a level check that never rose above the floor. Names two fixes the user can actually apply."
  },

  "sessionLengthTitle": "How long?",
  "@sessionLengthTitle": {
    "description": "Step 3 of R4.1.2: the session-length choice."
  },

  "sessionLengthMinutes": "{minutes} minutes",
  "@sessionLengthMinutes": {
    "description": "A session-length option in R4.1.2's third step.",
    "placeholders": { "minutes": { "type": "int", "example": "10" } }
  },

  "sessionLengthOpen": "Open-ended",
  "@sessionLengthOpen": {
    "description": "The session-length option with no timer."
  },

  "sessionStateListening": "Listening",
  "@sessionStateListening": {
    "description": "R4.2.1 requires the live screen to show partner state. The microphone is open."
  },

  "sessionStateThinking": "Thinking",
  "@sessionStateThinking": {
    "description": "R4.2.1 state: the user's turn is finished and the reply has not started."
  },

  "sessionStateSpeaking": "Speaking",
  "@sessionStateSpeaking": {
    "description": "R4.2.1 state: the partner is talking. The only state in which barge-in applies."
  },

  "sessionStateStarting": "Starting",
  "@sessionStateStarting": {
    "description": "R4.2.1 state: permissions and setup, before the first listen."
  },

  "sessionStatePaused": "Paused",
  "@sessionStatePaused": {
    "description": "R4.2.6 state: interrupted, and resumable with nothing lost."
  },

  "sessionMute": "Mute",
  "@sessionMute": {
    "description": "One of R4.2.1's three controls. Closes the microphone without ending the session."
  },

  "sessionUnmute": "Unmute",
  "@sessionUnmute": {
    "description": "Reopens the microphone after muting."
  },

  "sessionEnd": "End session",
  "@sessionEnd": {
    "description": "R4.2.1's third control. §7.6 names this exact wording as an example of a button that says what happens."
  },

  "sessionModeHandsFree": "Hands-free",
  "@sessionModeHandsFree": {
    "description": "R4.2.2's continuous-listening mode, where a pause in speech ends the turn."
  },

  "sessionModePushToTalk": "Push to talk",
  "@sessionModePushToTalk": {
    "description": "R4.2.2's held-control mode. Also the automatic suggestion in a noisy room."
  },

  "sessionHoldToSpeak": "Hold to speak",
  "@sessionHoldToSpeak": {
    "description": "Instruction on the waveform control while in push-to-talk mode."
  },

  "sessionNoisyTitle": "It is loud where you are",
  "@sessionNoisyTitle": {
    "description": "R4.2.2's noisy-room suggestion. A statement rather than a warning: the room is not the user's fault."
  },

  "sessionNoisySwitch": "Use push to talk",
  "@sessionNoisySwitch": {
    "description": "Accepts the noisy-room suggestion. R4.2.2 requires this to be a suggestion the user accepts, never a forced switch."
  },

  "sessionNoisyType": "Type instead",
  "@sessionNoisyType": {
    "description": "PROPOSALS P8: keep the session, switch to typing, keep the transcript and the report. Answers the category's top functional complaint, recognition failing in noise, where the incumbents leave the user stuck."
  },

  "sessionNoisyDismiss": "Keep going",
  "@sessionNoisyDismiss": {
    "description": "Declines the noisy-room suggestion and carries on unchanged."
  },

  "sessionTypeHint": "Type what you want to say",
  "@sessionTypeHint": {
    "description": "Placeholder in the typing fallback composer (P8)."
  },

  "sessionBackToSpeaking": "Back to speaking",
  "@sessionBackToSpeaking": {
    "description": "Leaves the typing fallback and reopens the microphone."
  },

  "sessionYou": "You",
  "@sessionYou": {
    "description": "Speaker label on the user's transcript lines (R4.2.5)."
  },

  "sessionHeardPoorly": "The microphone was not sure about this line.",
  "@sessionHeardPoorly": {
    "description": "Shown with a user line the recogniser had low confidence in, so a strange transcript reads as a mishearing rather than as the user's own words (R4.2.5)."
  },

  "sessionInterruptedCall": "Something else took the audio.",
  "@sessionInterruptedCall": {
    "description": "R4.2.6 pause reason: a call, an alarm, or another app took audio focus. Deliberately not 'incoming call' — audio focus covers more than calls, and naming only calls would be wrong most of the time."
  },

  "sessionInterruptedBackground": "You left the session.",
  "@sessionInterruptedBackground": {
    "description": "R4.2.6 pause reason: the app was backgrounded."
  },

  "sessionInterruptedHeadphones": "Your headphones came out.",
  "@sessionInterruptedHeadphones": {
    "description": "R4.2.6 pause reason: the audio route changed. Paused rather than continued, because the session would otherwise start playing aloud in a room."
  },

  "sessionInterruptedNetwork": "No internet. Your transcript is saved.",
  "@sessionInterruptedNetwork": {
    "description": "R4.2.6 pause reason. §7.6 gives almost exactly this sentence as its example of an error that states the cause and reassures about the work."
  },

  "sessionInterruptedMicrophone": "The microphone stopped responding.",
  "@sessionInterruptedMicrophone": {
    "description": "R4.2.6 pause reason: the recogniser failed permanently."
  },

  "sessionNothingLost": "Nothing is lost. Pick up where you stopped.",
  "@sessionNothingLost": {
    "description": "Reassurance under every pause reason. R4.2.6 requires that nothing is lost, and a user who does not believe that will end the session rather than resume it."
  },

  "sessionResume": "Resume",
  "@sessionResume": {
    "description": "Continues a paused session (R4.2.6)."
  },

  "sessionRemaining": "{minutes} minutes left today",
  "@sessionRemaining": {
