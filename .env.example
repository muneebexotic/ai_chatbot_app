# Template only. NAMES, NEVER VALUES. (PRD R9.6)
#
# Do not create a real `.env` next to this file. The app does not read `.env`
# at runtime — `flutter_dotenv` is not a dependency. A `.env` was committed to
# this repo for months with a live token in it precisely because it was a dead
# file nobody looked at. Build-time values are passed with --dart-define:
#
#   flutter run --dart-define=GEMINI_API_KEY=your_key_here
#
# ── Transitional (Milestone 0–2) ──────────────────────────────────────────
# These exist only until the gateway lands. Every one of them is a key
# shipped inside the APK, which is extractable by anyone who downloads it.
# That is why PRD F1/R9.3 move all model calls server-side in Milestone 3,
# after which this whole section is deleted.

GEMINI_API_KEY=

# Cut in Milestone 1 with the image-generation feature (PRD §2.2).
# Listed here only so the removed names are documented; do not populate.
HUGGING_FACE_TOKEN=
OPENAI_API_KEY=
STABILITY_API_KEY=

# ── End state (Milestone 2+) ──────────────────────────────────────────────
# Supabase URL and anon key are public by design; security comes from Row
# Level Security, not obscurity (PRD R9.6). These are safe to --dart-define.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secrets — the model key and the Play service account — live in
# Supabase Function secrets and MUST NOT appear here, in the client, or in
# any --dart-define. If you are tempted to add one, re-read SECURITY.md.
