# ── Patches and generated repo dumps ──────────────────────────────────────
# These get produced by tooling and committed by accident; they bloat the repo
# and are a common accidental exfiltration path for source and config.
*.patch
*.diff
all-files.txt
project_structure.text

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ── Misc ──────────────────────────────────────────────────────────────────
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
*.tmp
*.bak
*.orig
*.rej
*.sublime-workspace
*.sublime-project
migrate_working_dir/

# ── Generated localizations (R11.7) ───────────────────────────────────────
# `flutter gen-l10n` writes these next to the ARB files because Flutter
# removed the synthetic package. They are a build artefact of lib/l10n/*.arb
# and are regenerated by every `flutter pub get` (pubspec `generate: true`),
# so committing them only creates merge conflicts in a file nobody edits.
# The ARB files themselves ARE committed — they are the source.
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart
