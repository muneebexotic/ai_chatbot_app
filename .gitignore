# NOTE: this file must stay UTF-8 without a BOM.
# It was previously appended to with PowerShell's `>` / Add-Content, which
# writes UTF-16LE. Git read the resulting bytes as the literal `.\0e\0n\0v`,
# so the `.env` rule never matched and a live token stayed tracked for months.
# If you add entries from PowerShell, use:  Add-Content .gitignore 'rule' -Encoding utf8

# ── Secrets and credentials ───────────────────────────────────────────────
# Never relax these. See SECURITY.md.
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.jks
*.keystore
key.properties
android/key.properties
secrets.properties
service-account*.json
play-service-account*.json

# Platform config that carries project identifiers / API keys
android/local.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

